        "    comparacao[\"valor_final\"],\n",
        "    color=cores\n",
        ")\n",
        "\n",
        "ax.invert_yaxis()\n",
        "\n",
        "for barra in barras:\n",
        "    valor = barra.get_width()\n",
        "    ax.text(\n",
        "        valor + 450,\n",
        "        barra.get_y() + barra.get_height() / 2,\n",
        "        f\"R$ {valor:,.2f}\".replace(\",\", \"X\").replace(\".\", \",\").replace(\"X\", \".\"),\n",
        "        va=\"center\",\n",
        "        fontsize=10\n",
        "    )\n",
        "\n",
        "ax.set_title(\"Patrimônio final por alternativa — 2010 a 2025\")\n",
        "ax.set_xlabel(\"Valor em reais (R$)\")\n",
        "ax.set_xlim(0, comparacao[\"valor_final\"].max() * 1.23)\n",
        "ax.spines[[\"top\", \"right\", \"left\"]].set_visible(False)\n",
        "ax.tick_params(axis=\"y\", length=0)\n",
        "ax.grid(axis=\"x\", alpha=0.2)\n",
