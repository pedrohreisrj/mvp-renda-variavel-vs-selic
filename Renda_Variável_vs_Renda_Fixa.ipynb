        "\n",
        "# Comparação do patrimônio final — 2010 a 2025\n",
        "comparacao = dados[\"simulacao\"].copy()\n",
        "\n",
        "cores = [\"#3B82F6\", \"#16A34A\", \"#94A3B8\"]\n",
