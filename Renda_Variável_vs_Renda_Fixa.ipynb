        "\n",
        "# Conversão das colunas de data\n",
        "colunas_data = {\n",
        "    \"historico_b3\": [\"data\"],\n",
        "    \"precos\": [\"data\"],\n",
        "    \"selic\": [\"data\"],\n",
        "    \"ipca\": [\"data\"],\n",
        "    \"d2\": [\"primeira_data\", \"ultima_data\"],\n",
        "    \"d3\": [\"data_evento\"]\n",
        "}\n",
        "\n",
        "for nome, colunas in colunas_data.items():\n",
        "    for coluna in colunas:\n",
        "        dados[nome][coluna] = pd.to_datetime(\n",
        "            dados[nome][coluna],\n",
        "            errors=\"raise\"\n",
        "        )\n",
        "\n",
        "# Conferência dos tipos após a conversão\n",
        "for nome, colunas in colunas_data.items():\n",
        "    print(f\"\\n{nome.upper()}\")\n",
        "    print(dados[nome][colunas].dtypes)\n"
